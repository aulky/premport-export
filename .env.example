# ====== General ======
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/cookies.db

# Public address of the dashboard, used for link previews (WhatsApp etc.),
# canonical URLs, and the sitemap. If empty it is taken from the request.
# PUBLIC_URL=https://your-domain.com

# Long random string (16+ chars), used to encrypt cookies in the DB and sign sessions.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Password of the dashboard "admin" account (not the source account password).
# Other dashboard users are created by the admin on the Users page.
ADMIN_PASSWORD=
SESSION_TTL_SEC=43200
COOKIE_SECURE=false      # set to true when the dashboard is served over HTTPS

# For the IP in the access history. Default "loopback": trust X-Forwarded-For only
# from a reverse proxy on the same server (Nginx). If the proxy is on another
# machine, list its IP/CIDR here, comma separated.
# TRUST_PROXY=loopback

# ====== Source site connection ======
# premiumportal.id sits behind Cloudflare bot management, which blocks sign-in
# requests from automated browsers (Playwright and the like). Sign-in and status
# checks are therefore CODED DIRECTLY in scripts/portal_client.py (curl_cffi,
# imitating a real Chrome TLS fingerprint) -- there is no URL or selector to
# configure here.

# Python used to run scripts/portal_client.py (optional, default "python3" on
# Linux / "python" on Windows).
# PYTHON_BIN=python3

# ====== Worker ======
WORKER_TICK_SEC=15          # how often the worker checks its schedule (seconds)
CHECK_INTERVAL_SEC=300      # how often to check that a session is still alive
REFRESH_BEFORE_SEC=600      # sign in again N seconds before expiry (fallback; in practice a failed check triggers it)
KEEP_SNAPSHOTS=5
MAX_FAIL_BEFORE_BACKOFF=3

# ====== Accounts (add as many as you like with the next number) ======
# Passwords may contain # ! $ etc. Do not put a comment after a password line.
ACCOUNT_1_LABEL=Account 1
ACCOUNT_1_EMAIL=
ACCOUNT_1_PASSWORD=

ACCOUNT_2_LABEL=Account 2
ACCOUNT_2_EMAIL=
ACCOUNT_2_PASSWORD=
