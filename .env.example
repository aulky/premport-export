# ====== Umum ======
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/cookies.db

# String acak panjang (>=16 char), untuk enkripsi cookie di DB + sign session.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Password untuk masuk ke dashboard web (bukan password akun portal).
ADMIN_PASSWORD=
SESSION_TTL_SEC=43200
COOKIE_SECURE=false      # set true kalau web diakses via HTTPS

# ====== Koneksi ke situs sumber ======
# premiumportal.id ada di balik Cloudflare bot-management yang memblokir
# request login dari browser otomatisasi (Playwright dkk). Login & pengecekan
# status akun karena itu DIKODEKAN LANGSUNG di scripts/portal_client.py
# (curl_cffi, meniru TLS fingerprint Chrome asli) -- tidak ada URL/selector
# untuk dikonfigurasi di sini.

# Python yang dipakai untuk menjalankan scripts/portal_client.py (opsional,
# default "python3" di Linux / "python" di Windows).
# PYTHON_BIN=python3

# ====== Worker ======
WORKER_TICK_SEC=15          # interval worker memeriksa jadwal (detik)
CHECK_INTERVAL_SEC=300      # seberapa sering cek sesi masih hidup
REFRESH_BEFORE_SEC=600      # login ulang N detik sebelum expired (fallback; dalam praktik refresh dipicu saat cek sesi gagal)
KEEP_SNAPSHOTS=5
MAX_FAIL_BEFORE_BACKOFF=3

# ====== Akun (bisa banyak, tinggal tambah nomor berikutnya) ======
# Password boleh berisi # ! $ dll. Jangan beri komentar di belakang baris password.
ACCOUNT_1_LABEL=Akun 1
ACCOUNT_1_EMAIL=
ACCOUNT_1_PASSWORD=

ACCOUNT_2_LABEL=Akun 2
ACCOUNT_2_EMAIL=
ACCOUNT_2_PASSWORD=
